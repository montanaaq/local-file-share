<UserControl
    x:Class="Client.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Client.ViewModels"
    x:DataType="vm:MainViewModel">
    <StackPanel Spacing="18">
        <TextBlock Classes="title" Text="Настройки" />
        <TextBlock
            Margin="0,8,0,0"
            Classes="label"
            Text="Устройство" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="muted" Text="Имя" />
                <TextBox
                    IsEnabled="{Binding !StartSearchCommand.IsRunning}"
                    PlaceholderText="Имя устройства"
                    Text="{Binding Settings.ClientSettings.DeviceName, Mode=TwoWay}" />
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Classes="muted" Text="UDP-порт" />
                <NumericUpDown
                    IsEnabled="{Binding !StartSearchCommand.IsRunning}"
                    Maximum="65535"
                    Minimum="1"
                    Value="{Binding Settings.ClientSettings.LocalPort, Mode=TwoWay}" />
            </StackPanel>
        </Border>
        <Button
            HorizontalAlignment="Stretch"
            Classes="primary"
            Command="{Binding Settings.SaveSettingsCommand}"
            Content="Сохранить настройки" />
        <TextBlock Classes="muted" Text="{Binding Settings.SettingsMessage}" />
        <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                    <TextBlock Classes="label" Text="Обмен" />
                    <TextBlock Classes="muted" Text="{Binding NetworkMessage}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="{Binding Settings.IsExchangeEnabled, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </Grid>
        </Border>
        <Button
            Command="{Binding StartSearchCommand}"
            Content="Запустить сессию"
            IsVisible="{Binding !StartSearchCommand.IsRunning}" />
        <Button
            Command="{Binding StartSearchCancelCommand}"
            Content="Остановить сессию для изменения имени или порта"
            IsVisible="{Binding StartSearchCommand.IsRunning}" />
        <TextBlock Classes="muted" Text="Для изменения имени или порта остановите сессию. Настройки сети применяются сразу; сохраните их для следующего запуска."
            TextWrapping="Wrap" />
        <TextBlock
            Margin="0,8,0,0"
            Classes="label"
            Text="Тестирование сети" />
        <Border Classes="card">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="label" Text="Потери пакетов при отправке и приёме" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="#3869ED"
                        Text="{Binding Settings.LossRate, StringFormat='{}{0}%'}" />
                </Grid>
                <Slider
                    IsEnabled="{Binding !Settings.IsConnectionBroken}"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Settings.LossRate, Mode=TwoWay}" />
                <Grid ColumnDefinitions="*,*">
                    <TextBlock Classes="muted" Text="0%" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Classes="muted"
                        Text="100%" />
                </Grid>
            </StackPanel>
        </Border>
        <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                    <TextBlock Classes="label" Text="Обрыв связи" />
                    <TextBlock Classes="muted" Text="Устанавливает потери пакетов на 100%. При выключении возвращает прежнее значение."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="{Binding Settings.IsConnectionBroken, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
