<Window
    x:Class="Client.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="using:Client"
    xmlns:views="using:Client.Views"
    xmlns:vm="using:Client.ViewModels"
    Title="LocalFileShare"
    Width="560"
    Height="820"
    MinWidth="480"
    MinHeight="560"
    x:DataType="vm:MainViewModel"
    Background="White"
    RequestedThemeVariant="Light">
    <Window.Styles>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="TabControl.exchangeTabs > TabItem">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#60748C" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style Selector="TabControl.exchangeTabs > TabItem:selected">
            <Setter Property="Background" Value="#E9EFFF" />
            <Setter Property="Foreground" Value="#3869ED" />
        </Style>
        <Style Selector="TabControl.exchangeTabs > TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#EDF3F9" />
            <Setter Property="TextElement.Foreground" Value="#3D607E" />
        </Style>
        <Style Selector="TabControl.exchangeTabs > TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#DDE8FF" />
            <Setter Property="TextElement.Foreground" Value="#3869ED" />
        </Style>
        <Style Selector="TabControl.exchangeTabs > TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <ContainerQuery Name="client" Query="min-width:752">
            <Style Selector="TextBlock">
                <Setter Property="FontSize" Value="18" />
            </Style>
            <Style Selector="Button, TextBox, NumericUpDown">
                <Setter Property="FontSize" Value="18" />
            </Style>
            <Style Selector="SelectableTextBlock">
                <Setter Property="FontSize" Value="18" />
            </Style>
            <Style Selector="TabControl.exchangeTabs > TabItem">
                <Setter Property="FontSize" Value="18" />
            </Style>
            <Style Selector="TextBlock.muted, TextBlock.caption">
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style Selector="TextBlock.title">
                <Setter Property="FontSize" Value="32" />
            </Style>
            <Style Selector="TextBlock.brand">
                <Setter Property="FontSize" Value="28" />
            </Style>
        </ContainerQuery>
    </Window.Styles>
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    <Border
        Padding="24"
        Background="White"
        Container.Name="client"
        Container.Sizing="Width">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Border
                Padding="0,0,0,18"
                BorderBrush="#E2E9F2"
                BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border
                        Width="44"
                        Height="44"
                        Margin="0,0,10,0"
                        Background="#E9EFFF"
                        CornerRadius="22">
                        <Path
                            Width="24"
                            Height="24"
                            Data="M 10 13 A 5 5 0 0 0 17 13 L 20 10 A 5 5 0 0 0 13 3 L 11 5 M 14 11 A 5 5 0 0 0 7 11 L 4 14 A 5 5 0 0 0 11 21 L 13 19"
                            Stretch="Uniform"
                            Stroke="#3869ED"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="2" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Classes="brand"
                        FontWeight="Bold"
                        Text="LocalFileShare" />
                    <Border
                        Grid.Column="2"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Classes="sessionStatus"
                        Classes.active="{Binding IsNetworkActive}"
                        Classes.interrupted="{Binding IsConnectionInterrupted}"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <TextBlock
                            MaxWidth="120"
                            Classes="caption sessionStatus"
                            Classes.active="{Binding IsNetworkActive}"
                            Classes.interrupted="{Binding IsConnectionInterrupted}"
                            Text="{Binding SessionStatus}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                    <Button
                        Grid.Column="3"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        Padding="8"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Запустить сессию"
                        Classes="primary"
                        Command="{Binding StartSearchCommand}"
                        IsVisible="{Binding !StartSearchCommand.IsRunning}"
                        ToolTip.Tip="Запустить сессию">
                        <Path
                            Width="20"
                            Height="20"
                            Data="M 12 2 L 12 12 M 6 5 A 9 9 0 1 0 18 5"
                            Stretch="Uniform"
                            Stroke="{Binding $parent[Button].Foreground}"
                            StrokeLineCap="Round"
                            StrokeThickness="2" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        Padding="8"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Остановить сессию"
                        Classes="secondary"
                        Command="{Binding StartSearchCancelCommand}"
                        IsVisible="{Binding StartSearchCommand.IsRunning}"
                        ToolTip.Tip="Остановить сессию">
                        <Path
                            Width="20"
                            Height="20"
                            Data="M 12 2 L 12 12 M 6 5 A 9 9 0 1 0 18 5"
                            Stretch="Uniform"
                            Stroke="{Binding $parent[Button].Foreground}"
                            StrokeLineCap="Round"
                            StrokeThickness="2" />
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer
                Grid.Row="1"
                MaxHeight="260"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <Border
                        Margin="0,12,0,0"
                        Classes="incomingPanel"
                        IsVisible="{Binding TextExchange.HasTextNotification}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Margin="0,0,12,0" Spacing="4">
                                <TextBlock
                                    Classes="label"
                                    Text="{Binding TextExchange.TextNotificationMessage}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Classes="muted"
                                    Text="{Binding TextExchange.TextNotification.SenderName, StringFormat='От: {0}'}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Classes="primary"
                                Command="{Binding TextExchange.CopyReceivedTextCommand}"
                                CommandParameter="{Binding TextExchange.TextNotification}"
                                Content="Копировать" />
                            <Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="8"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Закрыть уведомление"
                                Classes="secondary"
                                Command="{Binding TextExchange.DismissTextNotificationCommand}"
                                Content="×"
                                ToolTip.Tip="Закрыть уведомление" />
                        </Grid>
                    </Border>
                    <Border
                        Margin="0,12,0,0"
                        Classes="notice"
                        IsVisible="{Binding IsConnectionInterrupted}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="warning" Text="Имитация обрыва: обмен данными приостановлен." />
                            <Button
                                Classes="secondary"
                                Command="{Binding Settings.RestoreConnectionCommand}"
                                Content="Восстановить связь" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="0,12,0,0"
                        Classes="incomingPanel"
                        IsVisible="{Binding IncomingFiles.HasActivity}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Classes="label"
                                IsVisible="{Binding IncomingFiles.HasIncomingFile}"
                                Text="{Binding IncomingFiles.Offers.Count, StringFormat='Входящие файлы · {0}'}" />
                            <ItemsControl ItemsSource="{Binding IncomingFiles.Offers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="client:IncomingFileOffer">
                                        <Border Margin="0,0,0,12" Classes="card">
                                            <StackPanel Spacing="10">
                                                <TextBlock
                                                    Classes="label"
                                                    Text="{Binding FileName}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock Classes="muted" Text="{Binding FormattedSize}" />
                                                <TextBlock Classes="muted" Text="{Binding SenderName, StringFormat='От: {0}'}" />
                                                <Grid ColumnDefinitions="*,12,*">
                                                    <Button
                                                        HorizontalAlignment="Stretch"
                                                        Classes="secondary"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).IncomingFiles.RejectIncomingFileCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="Отказаться" />
                                                    <Button
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Stretch"
                                                        Classes="primary"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).IncomingFiles.AcceptIncomingFileCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="Принять" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                Classes="muted"
                                Text="{Binding IncomingFiles.NetworkMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer
                Grid.Row="2"
                Margin="0,18,0,20"
                HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel IsVisible="{Binding IsHome}" Spacing="16">
                        <TextBlock Classes="title" Text="Отправка" />
                        <TextBlock
                            Classes="muted"
                            Text="{Binding NetworkMessage}"
                            TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="Получатель" />
                        <Border Classes="card" IsVisible="{Binding !HasSelectedDevice}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Classes="label"
                                    IsVisible="{Binding !HasDevices}"
                                    Text="Устройства не найдены" />
                                <TextBlock
                                    Classes="muted"
                                    IsVisible="{Binding !HasDevices}"
                                    Text="Запустите обмен на другом устройстве в той же локальной сети." />
                                <ListBox
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Devices}"
                                    SelectedItem="{Binding SelectedDevice}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="client:PeerItem">
                                            <Grid Margin="0,4" ColumnDefinitions="Auto,*">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,7,12,0"
                                                    VerticalAlignment="Top"
                                                    Classes="statusDot"
                                                    Classes.available="{Binding IsAvailable}" />
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock
                                                        Classes="label"
                                                        Text="{Binding Name}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock Classes="muted" Text="{Binding Endpoint}" />
                                                    <TextBlock Classes="muted" Text="{Binding Availability}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Classes="muted"
                            IsVisible="{Binding !HasSelectedDevice}"
                            Text="Выберите устройство в списке, чтобы открыть область отправки." />
                        <StackPanel IsVisible="{Binding HasSelectedDevice}" Spacing="16">
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Classes="label"
                                        Text="{Binding SelectedDevice.Name}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding SelectedDevice.Endpoint}" />
                                    <Button
                                        Classes="secondary"
                                        Command="{Binding ChangeRecipientCommand}"
                                        Content="Сменить получателя"
                                        IsEnabled="{Binding !FileTransfers.SendFileCommand.IsRunning}" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Classes="warning"
                                IsVisible="{Binding HasRecipientMessage}"
                                Text="{Binding RecipientMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TabControl Classes="exchangeTabs" SelectedIndex="0">
                            <TabItem Header="Файлы">
                                <StackPanel Margin="0,16,0,0" Spacing="16">
                                    <TextBlock
                                        Classes="muted"
                                        IsVisible="{Binding !HasSelectedDevice}"
                                        Text="Выберите получателя выше, чтобы отправить файл." />
                                    <StackPanel IsVisible="{Binding HasSelectedDevice}" Spacing="16">
                                        <Button
                                            Padding="22"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="Выбрать файл или перетащить его сюда"
                                            BorderThickness="1.5"
                                            Classes="fileDrop"
                                            Command="{Binding FileTransfers.ChooseFileCommand}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            DragDrop.AllowDrop="True"
                                            DragDrop.DragLeave="OnFileDragLeave"
                                            DragDrop.DragOver="OnFileDragOver"
                                            DragDrop.Drop="OnFileDrop"
                                            IsEnabled="{Binding !FileTransfers.SendFileCommand.IsRunning}">
                                            <StackPanel Spacing="10">
                                                <Path
                                                    Width="24"
                                                    Height="24"
                                                    Data="M12 3 v12 M17 8 l-5 -5 -5 5 M21 15 v4 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 v-4"
                                                    Stretch="Uniform"
                                                    Stroke="#7996C5"
                                                    StrokeJoin="Round"
                                                    StrokeLineCap="Round"
                                                    StrokeThickness="2" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="Перетащите файл сюда"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Classes="muted"
                                                    Text="{Binding FileTransfers.FileSizeHint}"
                                                    TextAlignment="Center" />

                                            </StackPanel>
                                        </Button>

                                        <Border Classes="card" IsVisible="{Binding FileTransfers.HasSelectedFile}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Margin="0,0,12,0" Spacing="5">
                                                    <TextBlock
                                                        Classes="label"
                                                        Text="{Binding FileTransfers.SelectedFileName}"
                                                        TextWrapping="Wrap"
                                                        ToolTip.Tip="{Binding FileTransfers.SelectedFilePath}" />
                                                    <TextBlock Classes="muted" Text="{Binding FileTransfers.SelectedFileSizeText}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Classes="secondary"
                                                    Command="{Binding FileTransfers.ClearSelectedFileCommand}"
                                                    Content="Убрать"
                                                    IsEnabled="{Binding !FileTransfers.SendFileCommand.IsRunning}" />
                                            </Grid>
                                        </Border>

                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Classes="primary"
                                            Command="{Binding FileTransfers.SendFileCommand}">
                                            <TextBlock
                                                Text="{Binding FileTransfers.Recipient.Name, StringFormat='Отправить устройству «{0}»'}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </Button>
                                        <ProgressBar
                                            Height="4"
                                            IsIndeterminate="True"
                                            IsVisible="{Binding FileTransfers.SendFileCommand.IsRunning}" />
                                        <TextBlock
                                            Classes="muted"
                                            IsVisible="{Binding FileTransfers.HasMessage}"
                                            Text="{Binding FileTransfers.NetworkMessage}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="{Binding TextExchange.ReceivedTexts.Count, StringFormat='Текст · {0}'}">
                                <StackPanel Margin="0,12,0,0" Spacing="8">
                                    <StackPanel.KeyBindings>
                                        <KeyBinding Gesture="Ctrl+V" Command="{Binding TextExchange.PasteTextCommand}" />
                                        <KeyBinding Gesture="Meta+V" Command="{Binding TextExchange.PasteTextCommand}" />
                                    </StackPanel.KeyBindings>
                                    <Button
                                        MinHeight="120"
                                        HorizontalAlignment="Stretch"
                                        Classes="secondary"
                                        Command="{Binding TextExchange.PasteTextCommand}"
                                        IsVisible="{Binding !TextExchange.HasTextToSend}">
                                        <TextBlock
                                            Classes="muted"
                                            Text="Вставьте текст из буфера обмена"
                                            TextAlignment="Center" />
                                    </Button>
                                    <Border Classes="card" IsVisible="{Binding TextExchange.HasTextToSend}">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="label" Text="Предпросмотр" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="muted"
                                                    Text="{Binding TextExchange.TextSizeText}" />
                                            </Grid>
                                            <ScrollViewer
                                                MaxHeight="220"
                                                HorizontalScrollBarVisibility="Disabled">
                                                <SelectableTextBlock
                                                    Text="{Binding TextExchange.TextToSend}"
                                                    TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        Classes="error"
                                        IsVisible="{Binding TextExchange.HasTextValidationError}"
                                        Text="{Binding TextExchange.TextValidationMessage}" />
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                        <Button
                                            Classes="secondary"
                                            Command="{Binding TextExchange.PasteTextCommand}"
                                            Content="Вставить" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Classes="secondary"
                                            Command="{Binding TextExchange.ClearTextCommand}"
                                            Content="Очистить"
                                            IsVisible="{Binding TextExchange.HasTextToSend}" />
                                        <Button
                                            Grid.Column="3"
                                            Classes="primary"
                                            Command="{Binding TextExchange.SendTextCommand}">
                                            <Grid>
                                                <TextBlock
                                                    Foreground="{Binding $parent[Button].Foreground}"
                                                    IsVisible="{Binding !TextExchange.SendTextCommand.IsRunning}"
                                                    Text="Отправить" />
                                                <TextBlock
                                                    Foreground="{Binding $parent[Button].Foreground}"
                                                    IsVisible="{Binding TextExchange.SendTextCommand.IsRunning}"
                                                    Text="Отправляем…" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        Classes="muted"
                                        IsVisible="{Binding TextExchange.HasMessage}"
                                        Text="{Binding TextExchange.TextMessage}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,12,0,4"
                                        Classes="label"
                                        IsVisible="{Binding !!TextExchange.ReceivedTexts.Count}"
                                        Text="Полученный текст" />
                                    <ItemsControl ItemsSource="{Binding TextExchange.ReceivedTexts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="client:ReceivedText">
                                                <Border Margin="0,0,0,12" Classes="card">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Classes="muted" Text="{Binding SenderName, StringFormat='От: {0}'}" />
                                                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                        <Button
                                                            HorizontalAlignment="Right"
                                                            Classes="secondary"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).TextExchange.CopyReceivedTextCommand}"
                                                            CommandParameter="{Binding}"
                                                            Content="Копировать" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                    <views:TransfersView IsVisible="{Binding IsTransfers}" />
                    <views:SettingsView IsVisible="{Binding IsSettings}" />
                </Grid>
            </ScrollViewer>
            <Border
                Grid.Row="3"
                Padding="0,10,0,0"
                BorderBrush="#E2E9F2"
                BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,8,*,8,*">
                    <Button
                        HorizontalAlignment="Stretch"
                        Classes="nav"
                        Classes.active="{Binding IsHome}"
                        Command="{Binding ShowHomeCommand}">
                        <StackPanel Spacing="5">
                            <Path
                                Width="20"
                                Height="20"
                                Data="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8 M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                                Stretch="Uniform"
                                Stroke="{Binding $parent[Button].Foreground}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.7" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="caption"
                                Foreground="{Binding $parent[Button].Foreground}"
                                Text="Главная" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Classes="nav"
                        Classes.active="{Binding IsTransfers}"
                        Command="{Binding ShowTransfersCommand}">
                        <StackPanel Spacing="5">
                            <Path
                                Width="20"
                                Height="20"
                                Data="M16 3 l4 4 -4 4 M20 7 H4 M8 21 l-4 -4 4 -4 M4 17 h16"
                                Stretch="Uniform"
                                Stroke="{Binding $parent[Button].Foreground}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.7" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="caption"
                                Foreground="{Binding $parent[Button].Foreground}"
                                Text="Передачи" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        Classes="nav"
                        Classes.active="{Binding IsSettings}"
                        Command="{Binding ShowSettingsCommand}">
                        <StackPanel Spacing="5">
                            <Path
                                Width="20"
                                Height="20"
                                Data="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915 M 15.0 12.0 A 3.0 3.0 0 1 1 9.0 12.0 A 3.0 3.0 0 1 1 15.0 12.0"
                                Stretch="Uniform"
                                Stroke="{Binding $parent[Button].Foreground}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.7" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="caption"
                                Foreground="{Binding $parent[Button].Foreground}"
                                Text="Настройки" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
