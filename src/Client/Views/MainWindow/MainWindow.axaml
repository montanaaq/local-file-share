<Window
    x:Class="Client.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="using:Client"
    xmlns:protocol="using:Protocol"
    xmlns:views="using:Client.Views"
    xmlns:vm="using:Client.ViewModels"
    Title="LocalFileShare"
    Width="560"
    Height="820"
    MinWidth="480"
    MinHeight="560"
    x:DataType="vm:MainViewModel"
    Background="White"
    Icon="/Assets/avalonia-logo.ico"
    RequestedThemeVariant="Light">
    <Window.Styles>
        <ContainerQuery Name="client" Query="min-width:752">
            <Style Selector="TextBlock">
                <Setter Property="FontSize" Value="18" />
            </Style>
            <Style Selector="Button, TextBox, NumericUpDown">
                <Setter Property="FontSize" Value="18" />
            </Style>
            <Style Selector="TextBlock.muted, TextBlock.caption">
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style Selector="TextBlock.title">
                <Setter Property="FontSize" Value="32" />
            </Style>
            <Style Selector="TextBlock.brand">
                <Setter Property="FontSize" Value="28" />
            </Style>
        </ContainerQuery>
    </Window.Styles>
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    <Border
        Padding="24"
        Background="White"
        Container.Name="client"
        Container.Sizing="Width">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border
                Padding="0,0,0,18"
                BorderBrush="#E2E9F2"
                BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border
                        Width="44"
                        Height="44"
                        Margin="0,0,10,0"
                        Background="#E9EFFF"
                        CornerRadius="22">
                        <Path
                            Width="24"
                            Height="24"
                            Data="M 10 13 A 5 5 0 0 0 17 13 L 20 10 A 5 5 0 0 0 13 3 L 11 5 M 14 11 A 5 5 0 0 0 7 11 L 4 14 A 5 5 0 0 0 11 21 L 13 19"
                            Stretch="Uniform"
                            Stroke="#3869ED"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="2" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Classes="brand"
                        FontWeight="Bold"
                        Text="LocalFileShare" />
                    <Border
                        Grid.Column="2"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Background="#EDF3F9"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <TextBlock
                                Classes="caption"
                                Foreground="#60748C"
                                IsVisible="{Binding !IsNetworkActive}"
                                Text="Не в сети" />
                            <TextBlock
                                Classes="caption"
                                Foreground="#22865E"
                                IsVisible="{Binding IsNetworkActive}"
                                Text="В сети" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <ScrollViewer
                Grid.Row="1"
                Margin="0,18,0,20"
                HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel IsVisible="{Binding IsHome}" Spacing="16">
                        <TextBlock Classes="title" Text="Отправка" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Classes="primary"
                            Command="{Binding StartSearchCommand}"
                            Content="Запустить обмен"
                            IsVisible="{Binding !StartSearchCommand.IsRunning}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Classes="secondary"
                            Command="{Binding StartSearchCancelCommand}"
                            Content="Завершить сессию"
                            IsVisible="{Binding StartSearchCommand.IsRunning}" />

                        <TextBlock
                            Classes="muted"
                            Text="{Binding NetworkMessage}"
                            TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="Получатель" />
                        <Border Classes="card" IsVisible="{Binding !HasSelectedDevice}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Classes="label"
                                    IsVisible="{Binding !HasDevices}"
                                    Text="Устройства не найдены" />
                                <TextBlock
                                    Classes="muted"
                                    IsVisible="{Binding !HasDevices}"
                                    Text="Запустите обмен на другом устройстве в той же локальной сети." />
                                <ListBox
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Devices}"
                                    SelectedItem="{Binding SelectedDevice}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="client:PeerItem">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="label" Text="{Binding Name}" />
                                                <TextBlock Classes="muted" Text="{Binding Endpoint}" />
                                                <TextBlock Classes="muted" Text="{Binding Availability}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Classes="muted"
                            IsVisible="{Binding !HasSelectedDevice}"
                            Text="Выберите устройство в списке, чтобы открыть область отправки." />
                        <StackPanel IsVisible="{Binding HasSelectedDevice}" Spacing="16">
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Classes="label"
                                        Text="{Binding SelectedDevice.Name}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding SelectedDevice.Endpoint}" />
                                    <Button
                                        Classes="secondary"
                                        Command="{Binding ChangeRecipientCommand}"
                                        Content="Сменить получателя" />
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="muted" Text="Получатель отдельно подтвердит или отклонит каждый файл." />
                            <Button
                                Padding="22"
                                Classes="fileDrop"
                                Command="{Binding FileTransfers.ChooseFileCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                AutomationProperties.Name="Выбрать файл или перетащить его сюда"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnFileDragOver"
                                DragDrop.DragLeave="OnFileDragLeave"
                                DragDrop.Drop="OnFileDrop"
                                BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                <StackPanel Spacing="10">
                                    <Path
                                        Width="24"
                                        Height="24"
                                        Data="M12 3 v12 M17 8 l-5 -5 -5 5 M21 15 v4 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 v-4"
                                        Stretch="Uniform"
                                        Stroke="#7996C5"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="Перетащите файл сюда"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Classes="muted"
                                        Text="{Binding FileTransfers.FileSizeHint}"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Classes="muted"
                                Text="{Binding FileTransfers.SelectedFilePath}"
                                TextWrapping="Wrap" />

                            <Button
                                HorizontalAlignment="Stretch"
                                Classes="primary"
                                Command="{Binding FileTransfers.SendFileCommand}"
                                Content="Отправить файл" />
                            <TextBlock Classes="label" Text="Текст из буфера" />
                            <TextBox
                                MinHeight="100"
                                MaxHeight="220"
                                AcceptsReturn="True"
                                PlaceholderText="Вставьте или напишите текст…"
                                Text="{Binding TextExchange.TextToSend, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Classes="muted"
                                Text="{Binding TextExchange.TextByteCount, StringFormat='Размер: {0} / 1000 байт'}" />
                            <TextBlock
                                Foreground="#B42318"
                                Text="{Binding TextExchange.TextValidationMessage}"
                                TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,12,*">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Classes="secondary"
                                    Command="{Binding TextExchange.PasteTextCommand}"
                                    Content="Вставить текст" />
                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    Classes="primary"
                                    Command="{Binding TextExchange.SendTextCommand}"
                                    Content="Отправить текст" />
                            </Grid>
                        </StackPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            Classes="label"
                            Text="Входящие файлы" />
                        <TextBlock
                            Classes="muted"
                            IsVisible="{Binding !FileTransfers.HasIncomingFile}"
                            Text="Нет входящих предложений файлов." />
                        <Border Classes="card" IsVisible="{Binding FileTransfers.HasIncomingFile}">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="label" Text="Принять выбранный файл?" />
                                <ListBox
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding FileTransfers.IncomingFiles}"
                                    SelectedItem="{Binding FileTransfers.SelectedIncomingFile, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="client:IncomingFileOffer">
                                            <StackPanel Spacing="6">
                                                <TextBlock
                                                    Classes="label"
                                                    Text="{Binding FileName}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock Classes="muted" Text="{Binding FormattedSize, StringFormat='Размер: {0}'}" />

                                                <TextBlock
                                                    Classes="muted"
                                                    Text="{Binding SenderName, StringFormat='Отправитель: {0}'}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid ColumnDefinitions="*,12,*">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Classes="secondary"
                                        Command="{Binding FileTransfers.AnswerIncomingFileCommand}"
                                        Content="Отказаться">
                                        <Button.CommandParameter>
                                            <x:Boolean>False</x:Boolean>
                                        </Button.CommandParameter>
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        Classes="primary"
                                        Command="{Binding FileTransfers.AnswerIncomingFileCommand}"
                                        Content="Принять">
                                        <Button.CommandParameter>
                                            <x:Boolean>True</x:Boolean>
                                        </Button.CommandParameter>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="label" Text="Полученный текст" />
                        <TextBlock
                            Classes="muted"
                            Text="{Binding TextExchange.TextMessage}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding TextExchange.ReceivedTexts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="client:ReceivedText">
                                    <Border Margin="0,0,0,12" Classes="card">
                                        <StackPanel Spacing="10">
                                            <TextBlock Classes="muted" Text="{Binding SenderName, StringFormat='От: {0}'}" />
                                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <Button
                                                HorizontalAlignment="Right"
                                                Classes="secondary"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).TextExchange.CopyReceivedTextCommand}"
                                                CommandParameter="{Binding}"
                                                Content="Копировать" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <views:TransfersView IsVisible="{Binding IsTransfers}" />
                    <views:SettingsView IsVisible="{Binding IsSettings}" />
                </Grid>
            </ScrollViewer>
            <Border
                Grid.Row="2"
                Padding="0,10,0,0"
                BorderBrush="#E2E9F2"
                BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,8,*,8,*">
                    <Button
                        HorizontalAlignment="Stretch"
                        Classes="nav"
                        Classes.active="{Binding IsHome}"
                        Command="{Binding ShowHomeCommand}">
                        <StackPanel Spacing="5">
                            <Path
                                Width="20"
                                Height="20"
                                Data="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8 M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                                Stretch="Uniform"
                                Stroke="{Binding $parent[Button].Foreground}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.7" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="caption"
                                Foreground="{Binding $parent[Button].Foreground}"
                                Text="Главная" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Classes="nav"
                        Classes.active="{Binding IsTransfers}"
                        Command="{Binding ShowTransfersCommand}">
                        <StackPanel Spacing="5">
                            <Path
                                Width="20"
                                Height="20"
                                Data="M16 3 l4 4 -4 4 M20 7 H4 M8 21 l-4 -4 4 -4 M4 17 h16"
                                Stretch="Uniform"
                                Stroke="{Binding $parent[Button].Foreground}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.7" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="caption"
                                Foreground="{Binding $parent[Button].Foreground}"
                                Text="Передачи" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        Classes="nav"
                        Classes.active="{Binding IsSettings}"
                        Command="{Binding ShowSettingsCommand}">
                        <StackPanel Spacing="5">
                            <Path
                                Width="20"
                                Height="20"
                                Data="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915 M 15.0 12.0 A 3.0 3.0 0 1 1 9.0 12.0 A 3.0 3.0 0 1 1 15.0 12.0"
                                Stretch="Uniform"
                                Stroke="{Binding $parent[Button].Foreground}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.7" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="caption"
                                Foreground="{Binding $parent[Button].Foreground}"
                                Text="Настройки" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
