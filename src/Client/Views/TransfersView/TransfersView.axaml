<UserControl
    x:Class="Client.Views.TransfersView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="using:Client"
    xmlns:vm="using:Client.ViewModels"
    VerticalAlignment="Top"
    x:DataType="vm:MainViewModel">
    <StackPanel Spacing="20">
        <TextBlock Classes="title" Text="Передачи" />
        <StackPanel IsVisible="{Binding FileTransfers.HasTransfers}" Spacing="8">
            <TextBlock Classes="label" Text="Отправитель" />
            <ComboBox
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Фильтр по отправителю"
                ItemsSource="{Binding FileTransfers.SenderNames}"
                SelectedIndex="{Binding FileTransfers.SelectedSenderIndex, Mode=TwoWay}" />
        </StackPanel>
        <Border Classes="card" IsVisible="{Binding !FileTransfers.HasTransfers}">
            <StackPanel Spacing="8">
                <TextBlock Classes="label" Text="Передач пока нет" />
                <TextBlock Classes="muted" Text="Здесь появятся отправленные и полученные файлы: прогресс, результат и причина ошибки." />
            </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding FileTransfers.VisibleTransfers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="client:TransferItem">
                    <Border Margin="0,0,0,12" Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Classes="label"
                                Text="{Binding FileName}"
                                TextWrapping="Wrap" />

                            <TextBlock Classes="muted" Text="{Binding DirectionText}" />
                            <TextBlock Classes="muted" Text="{Binding SenderName, StringFormat='От: {0}'}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Classes="transferState"
                                    Classes.completed="{Binding IsCompleted}"
                                    Classes.paused="{Binding IsPaused}"
                                    Classes.failed="{Binding IsFailed}"
                                    FontWeight="Bold"
                                    Text="{Binding StateSymbol}" />
                                <TextBlock
                                    Classes="label transferState"
                                    Classes.completed="{Binding IsCompleted}"
                                    Classes.paused="{Binding IsPaused}"
                                    Classes.failed="{Binding IsFailed}"
                                    Text="{Binding StateText}" />
                            </StackPanel>

                            <ProgressBar
                                Height="8"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding Progress}" />

                            <TextBlock Classes="muted" Text="{Binding ProgressText}" />

                            <TextBlock
                                Classes="error"
                                IsVisible="{Binding IsFailed}"
                                Text="{Binding ErrorText}"
                                TextWrapping="Wrap" />
                            <StackPanel IsVisible="{Binding IsPaused}" Spacing="8">
                                <TextBlock Classes="label" Text="{Binding PauseTimeText, StringFormat='До завершения ожидания: {0}'}" />
                                <TextBlock Classes="muted" Text="Ожидается восстановление связи. Прогресс сохранён." />

                                <Button
                                    HorizontalAlignment="Stretch"
                                    Classes="danger"
                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).FileTransfers.CancelPausedTransferCommand}"
                                    CommandParameter="{Binding}"
                                    Content="Отменить передачу" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
