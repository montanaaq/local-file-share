<UserControl
    x:Class="Client.Views.TransfersView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="using:Client"
    xmlns:vm="using:Client.ViewModels"
    Height="480"
    VerticalAlignment="Top"
    x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Classes="title" Text="Передачи" />
        <ScrollViewer
            Grid.Row="1"
            Margin="0,20"
            HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Transfers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="client:TransferItem">
                        <Border Margin="0,0,0,12" Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Classes="label"
                                    Text="{Binding FileName}"
                                    TextWrapping="Wrap" />

                                <TextBlock Classes="muted" Text="{Binding DirectionText}" />

                                <TextBlock Classes="label" Text="{Binding StateText}" />

                                <ProgressBar
                                    Height="8"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding Progress}" />

                                <TextBlock Classes="muted" Text="{Binding Progress, StringFormat='Прогресс: {0:0}%'}" />

                                <TextBlock
                                    Classes="muted"
                                    Text="{Binding Transfer.Error}"
                                    TextWrapping="Wrap" />
                                <StackPanel IsVisible="{Binding IsPaused}" Spacing="8">
                                    <TextBlock Classes="label" Text="{Binding PauseTimeText, StringFormat='До завершения ожидания: {0}'}" />
                                    <TextBlock Classes="muted" Text="Ожидается восстановление связи. Прогресс сохранён." />

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Classes="secondary"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CancelPausedTransferCommand}"
                                        CommandParameter="{Binding}"
                                        Content="Отменить передачу" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            Classes="secondary"
            Content="Подробности"
            IsEnabled="False" />
    </Grid>
</UserControl>
