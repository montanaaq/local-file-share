<UserControl
    x:Class="Client.Views.TransfersView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="480"
    VerticalAlignment="Top">
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Classes="title" Text="Передачи" />
        <ScrollViewer
            Grid.Row="1"
            Margin="0,20"
            HorizontalScrollBarVisibility="Disabled">
            <Border Padding="24" Classes="card">
                <StackPanel Spacing="12">
                    <Path
                        Width="32"
                        Height="32"
                        Data="M16 3 l4 4 -4 4 M20 7 H4 M8 21 l-4 -4 4 -4 M4 17 h16"
                        Stretch="Uniform"
                        Stroke="#8EA4BE"
                        StrokeJoin="Round"
                        StrokeLineCap="Round"
                        StrokeThickness="1.5" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="label"
                        Text="Передач пока нет" />
                    <TextBlock
                        Classes="muted"
                        Text="Здесь появятся прогресс, повторы и передачи на паузе."
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Button
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            Classes="secondary"
            Content="Подробности"
            IsEnabled="False" />
    </Grid>
</UserControl>
