<Application
    x:Class="Client.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Default">

    <Application.Resources>
        <CornerRadius x:Key="ControlCornerRadius">14</CornerRadius>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="Button, TextBox, NumericUpDown">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#213044" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#60748C" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.brand">
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="#946200" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.sessionStatus">
            <Setter Property="Foreground" Value="#60748C" />
        </Style>
        <Style Selector="TextBlock.sessionStatus.active">
            <Setter Property="Foreground" Value="#22865E" />
        </Style>
        <Style Selector="TextBlock.sessionStatus.interrupted">
            <Setter Property="Foreground" Value="#946200" />
        </Style>
        <Style Selector="Ellipse.statusDot">
            <Setter Property="Fill" Value="#94A3B8" />
        </Style>
        <Style Selector="Ellipse.statusDot.available">
            <Setter Property="Fill" Value="#22865E" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#F5F7FA" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="Border.incomingPanel">
            <Setter Property="Background" Value="#EDF3FF" />
            <Setter Property="BorderBrush" Value="#B9C9EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="#FFF6DF" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="TextBlock.transferState.completed">
            <Setter Property="Foreground" Value="#22865E" />
        </Style>
        <Style Selector="TextBlock.transferState.paused">
            <Setter Property="Foreground" Value="#946200" />
        </Style>
        <Style Selector="TextBlock.transferState.failed">
            <Setter Property="Foreground" Value="#B42318" />
        </Style>
        <Style Selector="Button.fileDrop">
            <Setter Property="Background" Value="#FAFBFF" />
            <Setter Property="BorderBrush" Value="#B9C9EE" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.fileDrop.dragover /template/ ContentPresenter#PART_ContentPresenter, Button.fileDrop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E9EFFF" />
            <Setter Property="BorderBrush" Value="#3869ED" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox, NumericUpDown, ListBoxItem">
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style Selector="Button:pressed, RepeatButton:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button:enabled">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2756D5" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCE8F5" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DDE8FF" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3869ED" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#EDF3F9" />
            <Setter Property="Foreground" Value="#3D607E" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FEECEB" />
            <Setter Property="Foreground" Value="#B42318" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7C8FA8" />
            <Setter Property="Padding" Value="8,10" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#E9EFFF" />
            <Setter Property="Foreground" Value="#3869ED" />
        </Style>
    </Application.Styles>
</Application>
